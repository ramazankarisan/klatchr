{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["vitest.config.ts", "playwright.config.ts"],
      "project": ["*.ts"]
    },
    "apps/server": {
      "entry": "src/index.ts!",
      "project": "src/**/*.ts"
    },
    "apps/web": {
      "entry": ["index.html!"],
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": ["jsdom"]
    }
  }
}
