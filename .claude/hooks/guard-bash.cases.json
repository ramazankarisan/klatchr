[
  ["git commit --no-verify -m x", "deny"],
  ["git push --no-verify", "deny"],
  ["git commit -n -m z", "deny"],
  ["git commit \"--no-verify\" -m x", "deny"],
  ["git -C . commit --no-verify", "deny"],
  ["HUSKY=0 git commit -m y", "deny"],
  ["export HUSKY=0; git commit", "deny"],
  ["git -c core.hooksPath=/dev/null commit -m x", "deny"],
  ["git config core.hooksPath /tmp", "deny"],
  ["git push origin main", "deny"],
  ["git -C . push origin main", "deny"],
  ["git push origin HEAD:refs/heads/main && echo ok", "deny"],
  ["cd repo && git push -u origin main", "deny"],
  ["git push -u origin claude/main-fix", "allow"],
  ["git push -q --force-with-lease", "allow"],
  ["echo docs mention --no-verify and HUSKY=0 here", "allow"],
  ["git commit -m 'skip --no-verify mention'", "allow"],
  ["git commit -q -F - <<'EOF'\nfix: denies --no-verify, HUSKY=0\nEOF", "allow"],
  ["git log -n 5", "allow"],
  ["git log --oneline origin/main", "allow"],
  ["git fetch origin main", "allow"],
  ["git config --get core.hooksPath", "allow"],
  ["grep -rn core.hooksPath .husky", "allow"]
]
