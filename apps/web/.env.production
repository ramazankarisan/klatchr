# Single-service prod build (7.3): the page and the socket share one origin, so the
# client talks to its own host. `same-origin` is expanded at runtime to ws(s)://<host>
# by the transport factory (wss under https) — the URL still comes from VITE_WS_URL
# (rule 6), we just don't bake a host. `vite build` loads this (production mode);
# `pnpm dev` (mock) and `--mode e2e` (.env.e2e) are unaffected.
VITE_WS_URL=same-origin
